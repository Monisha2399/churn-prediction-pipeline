{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Customer Churn Prediction — MLOps Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"fastapi\"}[1m])",
          "legendFormat": "{{method}} {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "API p95 Latency (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"fastapi\"}[5m])) * 1000",
          "legendFormat": "p95 latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "fixedColor": "orange", "mode": "fixed" } }
      }
    },
    {
      "id": 3,
      "title": "API Error Rate (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 * rate(http_requests_total{job=\"fastapi\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"fastapi\"}[5m])",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Model Version in Production",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT model_version FROM predictions ORDER BY created_at DESC LIMIT 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }
      }
    },
    {
      "id": 5,
      "title": "Daily Predicted Churn Rate (%)",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "rawSql": "SELECT snapshot_date AS time, ROUND(100.0 * SUM(churn_label) / COUNT(*), 2) AS churn_rate FROM predictions GROUP BY snapshot_date ORDER BY snapshot_date;",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 6,
      "title": "Churn Score Distribution",
      "type": "histogram",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT churn_probability FROM predictions WHERE snapshot_date = (SELECT MAX(snapshot_date) FROM predictions);",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" } }
      }
    },
    {
      "id": 7,
      "title": "Mean Sentiment Score (Drift Check)",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "rawSql": "SELECT snapshot_date AS time, ROUND(AVG(sentiment_mean)::numeric, 4) AS avg_sentiment FROM features GROUP BY snapshot_date ORDER BY snapshot_date;",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "teal", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": -1 },
              { "color": "yellow", "value": -0.3 },
              { "color": "green",  "value": 0 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["churn", "mlops"],
  "title": "Churn Prediction Dashboard",
  "uid": "churn-mlops-v1",
  "version": 1
}
